{
  "name": "@jackrocca/rock-ui",
  "version": "0.1.0",
  "description": "Standalone RockUI component library: small prop APIs over Base UI, with shared Tailwind tokens.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackrocca/rock-ui.git"
  },
  "exports": {
    "./theme.css": "./theme.css",
    "./components/*": "./components/*",
    "./primitives/*": "./primitives/*",
    "./hooks/*": "./hooks/*",
    "./lib/*": "./lib/*"
  },
  "files": [
    "components",
    "primitives",
    "hooks",
    "lib",
    "theme.css",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "npm run check:boundaries && npm run ui:verify && npm run typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "ui:verify": "node scripts/verify-ui.mjs",
    "ui:prepare": "node scripts/prepare-ui.mjs",
    "ui:snapshot": "node scripts/snapshot-kitze.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@iconify/react": "^6.0.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@number-flow/react": "0.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^4.20.7",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "10.0.2",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "use-long-press": "^3.3.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
